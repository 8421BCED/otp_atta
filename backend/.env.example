# FXEC AttendOTP - environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=production
APP_URL=https://otpattendance.fxcams.in
CORS_ORIGIN=https://otpattendance.fxcams.in
# Number of reverse proxies in front of Node (nginx = 1, nginx behind Cloudflare = 2)
TRUST_PROXY_HOPS=1

# Database (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=attendotp
DB_PASSWORD=change_me
DB_NAME=otp_attendance
# Per worker process. With PM2 cluster the total is DB_CONNECTION_LIMIT x workers.
DB_CONNECTION_LIMIT=15

# Secrets (required, at least 32 characters, app refuses to start without them)
JWT_SECRET=generate_with__node_-e_"console.log(require('crypto').randomBytes(48).toString('base64url'))"
ITOPS_PASSPHRASE=a_long_random_passphrase_for_the_IT_operations_console

# Sign-in
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
COLLEGE_DOMAIN=@francisxavier.ac.in

# Sign-in. Google is the real way in. Password login stays off unless you turn it on.
PASSWORD_LOGIN=false

# Days with no classes every week (0 = Sunday ... 6 = Saturday)
WEEKLY_OFF_DAYS=0

# Departments that share one HOD, written as A|B;C|D
DEPARTMENT_GROUPS=AI-DS|AI-ML

# Doorbell push notifications. Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://otpattendance.fxcams.in

# Testing only. Lets the Principal clock override change server time. Keep false in production.
ALLOW_TIME_SIMULATION=false

# AI headcount (optional, loaded on first use)
# Set to false to skip loading the ONNX models entirely.
HEADCOUNT_ENABLED=true


