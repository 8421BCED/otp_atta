# FXEC AttendOTP - Production Environment Variables Example
# Copy this file to .env and configure your production credentials

# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://otpattendance.fxcams.in

# Database Configuration (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=otp_attendance
DB_CONNECTION_LIMIT=50

# Security Secrets (Must be at least 32 characters long)
JWT_SECRET=your_production_secret_key_change_me_before_deploying

# Firebase Admin SDK (Optional: For Push Doorbell Notifications)
# Place serviceAccountKey.json in the backend/ directory or provide path:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
